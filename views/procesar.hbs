{{> "partials/header" }}
{{> "partials/nav"}}


<div class="card bg-[#2e3b32] text-white p-4" style="font-family: 'Courier New'">
  <h4 class="mb-4 text-success border-bottom">Datos de Pago Seguro</h4>
  <form action="/pago/procesar" method="POST">
    <div class="mb-3">
      <label>Nombre en la Tarjeta</label>
      <input type="text" name="nombre_tarjeta" class="form-control bg-transparent text-white" required>
    </div>
    <div class="mb-3">
      <label>Número de Tarjeta</label>
      <input type="text" name="numero" class="form-control bg-transparent text-white" placeholder="0000 0000 0000 0000">
    </div>
    <div class="row">
      <div class="col-md-4">
        <label>Mes (MM)</label>
        <input type="text" name="mes" class="form-control bg-transparent text-white">
      </div>
      <div class="col-md-4">
        <label>Año (AA)</label>
        <input type="text" name="anio" class="form-control bg-transparent text-white">
      </div>
      <div class="col-md-4">
        <label>CVV</label>
        <input type="password" name="cvv" class="form-control bg-transparent text-white">
      </div>
    </div>
    <button type="submit" class="btn btn-success w-100 mt-4">Pagar Q 300.00 </button>
  </form>
</div>

{{> "partials/footer"}}
