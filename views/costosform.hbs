{{> 'partials/header' }}
{{> 'partials/nav' }}
<h1>{{Title}}</h1>

<div class="container mt-4">
  <div class="card bg-dark border-info shadow-lg">
    <div class="card-header bg-info text-dark d-flex justify-content-between align-middle">
      <h4 class="mb-0 font-monospace">🏭 MODULO DE COSTOS DE PRODUCCIÓN</h4>
      <span class="badge bg-dark">Serie 300,000</span>
    </div>
    <div class="card-body text-white">
      <form id="formCostos" method="POST" action="/estados/costos">

        {{#each Cuentas}}
        <div class="row mb-2 align-items-center hover-row">
          <div class="col-8">
            <label class="font-monospace" style="color: #0dcaf0;">{{Codigo}}</label>
            <span class="ms-2 fw-bold text-light">{{Nombre}}</span>
          </div>
          <div class="col-4">
            <input type="number" step="0.01" name="{{Codigo}}" id="input-{{Codigo}}"
              class="form-control bg-transparent text-white border-info text-end">
          </div>
        </div>
        {{/each}}

        <div class="mt-4 border-top border-info pt-3 text-center">
          <button type="submit" class="btn btn-outline-info btn-lg w-50 font-monospace">
            PROCESAR ESTADOS
          </button>
        </div>
      </form>
    </div>
  </div>
</div>


{{>'partials/footer'}}
