{{>'partials/header'}}
{{>'partials/nav'}}
<div class="container py-5">
  <div class="row">
    <div class="col-lg-7">
      <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between">
          <span>Nomenclatura Actual</span>
          <input type="text" id="buscarCuenta" class="form-control form-control-sm w-50" placeholder="Buscar...">
        </div>
        <div class="card-body p-0" style="max-height: 500px; overflow-y: auto;">
          <table class="table table-hover mb-0">
            <thead class="table-light sticky-top">
              <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Saldo</th>
                <th>EsCosto</th>
                <th class="text-center">Acción</th>
              </tr>
            </thead>
            <tbody>
              {{#each todasLasCuentas}}
              <tr>
                <td><code>{{this.Codigo}}</code></td>
                <td>{{this.Nombre}}</td>
                <td><span class="badge bg-secondary">{{this.Categoria}}</span></td>
                <td>
                  {{#if this.EsCosto}}
                  <span class="badge bg-info text-dark">SÍ</span>
                  {{else}}
                  <span class="badge bg-light text-dark">NO</span>
                  {{/if}}
                </td>
                <td>{{this.Saldo}}</td>
                <td class="text-center">
                  <button type="button" class="btn btn-warning btn-sm" data-bs-toggle="modal"
                    data-bs-target="#modalEditar"
                    onclick="llenarModal('{{this.Codigo}}', '{{this.Nombre}}', '{{this.Categoria}}', '{{this.Saldo}}', {{this.EsCosto}})">
                    <i class="fas fa-edit"></i>
                  </button>
                  <a href="/api/admin/eliminar-cuenta/{{this.Codigo}}" class="btn btn-outline-danger btn-sm"
                    onclick="return confirm('¿Estás seguro de eliminar la cuenta: {{this.Nombre}}? Esta acción no se puede deshacer.')">
                    <i class="fas fa-trash"></i>
                  </a>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card shadow border-primary">
        <div class="card-header bg-primary text-white">Nueva Cuenta</div>
        <form action="/api/admin/crearcuenta" method="POST" class="card-body">
          {{#if error}}<div class="alert alert-danger">{{error}}</div>{{/if}}
          {{#if success}}<div class="alert alert-success">{{success}}</div>{{/if}}

          <div class="mb-3">
            <label>Código Contable</label>
            <input type="number" name="codigo" class="form-control" required>
          </div>
          <div class="mb-3">
            <label>Nombre de la Cuenta</label>
            <input type="text" name="nombre" class="form-control" required>
          </div>
          <div class="mb-3">
            <label>Categoría Reporte</label>
            <select name="categoria" class="form-select">
              <option value="Disponible">Disponible</option>
              <option value="Exigible">Exigible</option>
              <option value="Realisable">Realisable</option>
              <option value="PropPlanEqui">Propiedad Planta y Equipo</option>
              <option value="GtoIntan">Gastos Intangibles</option>
              <option value="GtoDiferidos">Gastos Diferidos</option>
              <option value="PasivoCorr">Pasivo Corriente</option>
              <option value="PasivoNoCorr">Pasivo No Corriente</option>
              <option value="PatriNeto">Patrimonio</option>
              <option value="Ingresos">Ingresos</option>
              <option value="InveIni">Inventarios Iniciales</option>
              <option value="Compras">Compras</option>
              <option value="InveFin">Inventarios Finales</option>
              <option value="GtoVentas">Gastos de Ventas</option>
              <option value="GtoAdmin">Gatos de Administracion</option>
              <option value="IngrFina">Ingrsos Financieros</option>
              <option value="GastosFina">Gastos Financieros</option>
              <option value="OtrosGtoFina">Otros Gastos Financieros</option>
              <option value="Otring">Otros Ingresos Financieros</option>
              <!-- MateriaPrima     []models.Cue -->
              <!-- ManoObra         []models.Cue -->
              <!-- GastosFabrica    []models.Cue -->
              <!-- ProductosProceso []models.Cue -->
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Saldo</label>
            <select name="saldo" class="form-select">
              <option value="activo">Activo</option>
              <option value="pasivo">Pasivo</option>
              <option value="perdida">Perdida</option>
              <option value="ganancia">Ganancia</option>
              <option value="costo_debe">Costo Produccion Deve</option>
              <option value="costo_haber">Costo Produccion Haber</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Es Costo</label>
            <select name="escosto" class="form-select">
              <option value="true">Es Costo</option>
              <option value="false">No Es Costo</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary w-100">Registrar en Supabase</button>
        </form>
      </div>
    </div>
  </div>
</div>
<div class="modal fade" id="modalEditar" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form action="/api/admin/editar-cuenta" method="POST" class="modal-content">
      <div class="modal-header bg-warning text-dark">
        <h5 class="modal-title">Editar Cuenta</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" name="Codigo" id="edit_codigo">

        <div class="mb-3">
          <label class="form-label">Nombre de la Cuenta</label>
          <input type="text" name="nombre" id="edit_nombre" class="form-control" required>
        </div>

        <div class="mb-3">
          <label class="form-label">Categoría</label>
          <select name="categoria" id="edit_categoria" class="form-select">
            <option value="Disponible">Disponible</option>
            <option value="Exigible">Exigible</option>
            <option value="Realisable">Realisable</option>
            <option value="PropPlanEqui">Propiedad Planta y Equipo</option>
            <option value="GtoIntan">Gastos Intangibles</option>
            <option value="GtoDiferidos">Gastos Diferidos</option>
            <option value="PasivoCorr">Pasivo Corriente</option>
            <option value="PasivoNoCorr">Pasivo No Corriente</option>
            <option value="PatriNeto">Patrimonio</option>
            <option value="Ingresos">Ingresos</option>
            <option value="InveIni">Inventarios Iniciales</option>
            <option value="Compras">Compras</option>
            <option value="InveFin">Inventarios Finales</option>
            <option value="GtoVentas">Gastos de Ventas</option>
            <option value="GtoAdmin">Gatos de Administracion</option>
            <option value="IngrFina">Ingrsos Financieros</option>
            <option value="GastosFina">Gastos Financieros</option>
            <option value="OtrosGtoFina">Otros Gastos Financieros</option>
            <option value="Otring">Otros Ingresos Financieros</option>
            <!-- MateriaPrima     []models.Cue -->
            <!-- ManoObra         []models.Cue -->
            <!-- GastosFabrica    []models.Cue -->
            <!-- ProductosProceso []models.Cue -->

          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Saldo</label>
          <select name="saldo" class="form-select">
            <option value="activo">Activo</option>
            <option value="pasivo">Pasivo</option>
            <option value="perdida">Perdida</option>
            <option value="ganancia">Ganancia</option>
            <option value="costo_debe">Costo Produccion Deve</option>
            <option value="costo_haber">Costo Produccion Haber</option>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label">Es Costo</label>
          <select name="escosto" class="form-select">
            <option value="true">Es Costo</option>
            <option value="false">No Es Costo</option>
          </select>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
      </div>
    </form>
  </div>
</div>
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1060">
  <div id="liveToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive"
    aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body">
        <i class="fas fa-check-circle me-2"></i> ¡Cuenta actualizada con éxito!
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="modal"
        aria-label="Close"></button>
    </div>
  </div>
</div>
<script src="/static/js/nomenclatura.js"></script>
{{>'partials/footer'}}
