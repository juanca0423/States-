{{> 'partials/header' }}
{{> 'partials/nav' }}
<div class="card-body bg-light border-bottom">
  <div class="row">
    <div class="col-md-6">
      <div class="input-group">
        <span class="input-group-text bg-white border-end-0">
          <i class="fas fa-search text-muted"></i>
        </span>
        <input type="text" id="busquedaUsuario" class="form-control border-start-0 ps-0"
          placeholder="Buscar por nombre o email..." onkeyup="filtrarUsuarios()">
      </div>
    </div>
  </div>
</div>
<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-secondary fw-bold"><i class="fas fa-chart-pie me-2"></i>Resumen del Sistema</h2>
    <span class="badge bg-dark px-3 py-2">Modo Administrador</span>
  </div>

  <div class="row">
    <div class="col-md-4 mb-4">
      <div class="card border-0 shadow-sm h-100 border-start border-primary border-5">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted text-uppercase small fw-bold">Total Usuarios</h6>
              <h2 class="fw-bold mb-0">{{Total}}</h2>
            </div>
            <div class="icon-box bg-primary-subtle p-3 rounded-circle">
              <i class="fas fa-users fa-2x text-primary"></i>
            </div>
          </div>
          <div class="mt-3">
            <small class="text-success"><i class="fas fa-arrow-up"></i> Crecimiento activo</small>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4 mb-4">
      <div class="card border-0 shadow-sm h-100 border-start border-warning border-5">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h6 class="text-muted text-uppercase small fw-bold">Dudas Pendientes</h6>
              <h2 class="fw-bold mb-0 text-warning">{{ConsultasPendientes}}</h2>
            </div>
            <div class="icon-box bg-warning-subtle p-3 rounded-circle">
              <i class="fas fa-envelope-open-text fa-2x text-warning"></i>
            </div>
          </div>
          <div class="mt-3">
            <a href="/api/admin/soporte" class="text-decoration-none small">Revisar bandeja →</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card shadow-sm border-0 mt-2">
    <div class="card-header bg-white py-3">
      <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-list me-2"></i>Últimos Usuarios Registrados</h5>
    </div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Usuario</th>
              <th>Contacto</th>
              <th>Fecha Registro</th>
              <th class="text-center">Estado</th>
            </tr>
          </thead>
          <tbody>
            {{#each Usuarios}}
            <tr>
              <td>
                <div class="d-flex align-items-center">
                  <div
                    class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-2"
                    style="width: 35px; height: 35px;">
                    {{#if (eq this.Nombre "")}}?{{else}}{{slice this.Nombre 0 1}}{{/if}}
                  </div>
                  <span class="fw-semibold">{{this.Nombre}} {{this.Apellido}}</span>
                </div>
              </td>
              <td><i class="far fa-envelope me-1 text-muted"></i> {{this.Email}}</td>
              <td><small>{{fechaCorta this.CreatedAt}}</small></td>
              <td class="text-center">
                {{#if this.SuscripcionActiva}}
                <span class="badge rounded-pill bg-success-subtle text-success border border-success px-3">Activo</span>
                {{else}}
                <span class="badge rounded-pill bg-light text-dark border px-3">Prueba</span>
                {{/if}}
              </td>
              <td>
                <div class="btn-group">
                  <button class="btn btn-sm btn-outline-primary" onclick="verUsuario({{this.ID}})">
                    <i class="fas fa-eye"></i>
                  </button>
                  <button class="btn btn-sm btn-outline-success" onclick="activarSuscripcion({{this.ID}}, event)">
                    <i class="fas fa-check-circle"></i>
                  </button>
                </div>
              </td>
            </tr>
            {{/each}}
            <tr id="noResultados" style="display: none;">
              <td colspan="5" class="text-center py-4 text-muted">
                <i class="fas fa-user-slash fa-2x mb-2"></i>
                <p>No se encontraron usuarios que coincidan con la búsqueda.</p>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<div class="modal fade" id="userModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title"><i class="fas fa-id-card me-2"></i>Detalles del Usuario</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="modalContent">
        <div class="text-center p-4">
          <div class="spinner-border text-primary" role="status"></div>
          <p class="mt-2 text-muted">Cargando información...</p>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="/static/js/miscript.js"></script>
{{> 'partials/footer' }}
