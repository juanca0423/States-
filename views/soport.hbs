{{> 'partials/header' }}
{{> 'partials/nav' }}

<style>
  /* Estos estilos se cargan solo para Soporte */
  .card-consultoria {
    background-color: #3d5245;
    border: 1px solid #4a5d4e;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  }

  /* Arreglo para que el placeholder se vea claro sobre fondo oscuro */
  .form-control-soporte::placeholder {
    color: rgba(255, 255, 255, 0.6) !important;
    font-style: italic;
  }

  .form-control-soporte {
    background-color: rgba(0, 0, 0, 0.2) !important;
    color: #ffffff !important;
    border: 1px solid #5a6e5e !important;
  }

  .form-control-soporte:focus {
    background-color: rgba(0, 0, 0, 0.3) !important;
    border-color: #28a745 !important;
    box-shadow: 0 0 0 0.25rem rgba(40, 167, 69, 0.25);
    color: #fff !important;
  }

  .historial-titulo {
    color: #3d5245;
    border-bottom: 2px solid #3d5245;
    display: inline-block;
    padding-bottom: 5px;
  }
</style>

<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-10">

      <div class="mb-4">
        <h1 class="text-success fw-bold"><i class="fas fa-headset"></i> {{Title}}</h1>
        <p class="text-muted">Canal exclusivo para resolución de dudas contables y técnicas.</p>
      </div>

      <div class="card card-consultoria mb-5">
        <div class="card-body p-4">
          <form action="/soporte/enviar" method="POST">
            <div class="mb-3">
              <label class="form-label text-white fw-bold">Escriba su consulta o sugerencia:</label>
              <textarea name="consulta" class="form-control form-control-soporte" rows="4"
                placeholder="Ej: ¿Cómo sugiere clasificar los Gastos de Organización según NIIF Pymes?"></textarea>
            </div>
            <div class="text-end">
              <button type="submit" class="btn btn-success btn-lg px-5">
                <i class="fas fa-paper-plane"></i> Enviar a Consultoría
              </button>
            </div>
          </form>
        </div>
      </div>

      <h4 class="historial-titulo mb-4">Historial de Consultas</h4>

      {{#each Consultas}}
      <div class="card mb-3 shadow-sm"
        style="border-left: 5px solid {{#if this.Respuesta}}#28a745{{else}}#ffc107{{/if}};">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <small class="text-muted"><i class="far fa-calendar-alt"></i> {{this.CreatedAt}}</small>
            <span class="badge {{#if this.Respuesta}}bg-success{{else}}bg-warning text-dark{{/if}}">
              {{#if this.Respuesta}}Resuelto{{else}}Pendiente{{/if}}
            </span>
          </div>

          <p class="mb-1 text-dark"><strong>Consulta:</strong></p>
          <p class="text-secondary bg-light p-2 rounded">{{this.Consulta}}</p>

          {{#if this.Respuesta}}
          <div class="p-3 mt-3 rounded border-start border-4 border-success" style="background-color: #f1f8f4;">
            <p class="mb-1 text-success"><strong><i class="fas fa-user-tie"></i> Respuesta del Experto:</strong></p>
            <p class="text-dark mb-0" style="font-style: italic;">{{this.Respuesta}}</p>
          </div>
          {{else}}
          <div class="mt-2 text-warning small">
            <i class="fas fa-clock"></i> Su consulta está siendo analizada por un especialista...
          </div>
          {{/if}}
        </div>
      </div>
      {{else}}
      <div class="text-center py-5 bg-light rounded">
        <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
        <p class="text-muted">Aún no ha realizado ninguna consulta.</p>
      </div>
      {{/each}}

    </div>
  </div>
</div>

{{> 'partials/footer' }}
