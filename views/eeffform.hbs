{{>'partials/header'}}
{{>'partials/nav'}}
<div class="shortcuts-bar bg-dark text-light py-2 border-bottom sticky-top" style="z-index: 101;">
  <div class="container-fluid d-flex justify-content-center gap-4">
    <span class="badge bg-secondary"><kbd>Alt</kbd> + <kbd>C</kbd> Calculadora</span>
    <span class="badge bg-secondary"><kbd>Ctrl</kbd> + <kbd>S</kbd> Guardar Balance</span>
    <span class="badge bg-secondary"><kbd>Enter</kbd> Siguiente Campo</span>
    <span class="badge bg-secondary"><kbd>P</kbd> Pegar desde Calc</span>
    <span class="badge bg-secondary"><kbd>Esc</kbd> Cerrar Calc</span>
  </div>
</div>
<section class="container mt-4">
<form class="card bg-dark p-4 border-success shadow-lg" id="balanceForm" method="POST" enctype="multipart/form-data"
    action="/estados">
    <div class="table-responsive">
      <table class="table table-dark table-hover mb-0">
        <thead class="text-success">
          <tr>
            <th style="width: 50%">Cuenta Contable</th>
            <th style="width: 30%" class="text-center">Monto</th>
          </tr>
        </thead>
        <tbody>
          {{#each Cuentas}}
          <tr>
            <td class="align-middle">
              <label for="input-{{Codigo}}" class="text-white mb-0 fw-bold">
                {{Nombre}}
              </label>
            </td>
            <td>
              <input type="text" id="input-{{Codigo}}" data-saldo="{{Saldo}}" name="{{Codigo}}" step="0.01"
                class="form-control monto-contable input-contable w-100 bg-transparent text-white border-info text-end">
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <div class="text-center mt-4">
      <button type="submit" class="btn btn-success btn-lg px-5 shadow">
        <i class="fas fa-save me-2"></i>Generar Estados Financieros
      </button>
    </div>
  </form>
</section>
<div id="cuadroCuadre" class="cuadre-flotante shadow-lg">
  <div class="cuadre-label">DIFERENCIA</div>
  <div id="diffValue" class="cuadre-monto">0.00</div>
</div>
<button id="btnSumadora" class="btn btn-success rounded-circle shadow-lg" onclick="toggleCalc()"
  style="position: fixed; bottom: 20px; left: 10px; width: 60px; height: 60px; z-index: 10000;">
  <i class="fas fa-calculator fa-lg"></i>
</button>

<div id="calculadoraContable" class="card shadow-lg d-none"
  style="position: fixed; top: 100px; left: 20px; width: 260px; z-index: 9999; border: 2px solid #28a745; background: white;">

  <div id="calcHeader"
    class="card-header bg-success text-white d-flex justify-content-between align-items-center py-1 calc-header">
    <span style="font-size: 0.85rem;"><i class="fas fa-calculator me-2"></i>Sumadora</span>
    <button type="button" class="btn btn-sm p-0 me-2 text-white" onclick="minimizarCalc()">
      <i class="fas fa-minus"></i>
    </button>
    <button type="button" class="btn-close btn-close-white" style="font-size: 0.7rem;" onclick="toggleCalc()"></button>
  </div>

  <div class="card-body p-2 bg-white">
    <div id="cintaContable" class="p-2 mb-2 rounded"
      style="height: 100px; overflow-y: auto; font-family: 'Courier New', monospace; font-size: 0.85rem; text-align: right; background-color: #f8f9fa;">
      <div class="text-muted small text-center border-bottom mb-1">REGISTRO</div>
    </div>

    <input type="text" id="displayCalc" class="form-control form-control-sm text-end mb-2 fw-bold" readonly value="0"
      style="background-color: #e9ecef; font-size: 1.4rem;">

    <div class="row g-1">
      <div class="col-3"><button class="btn btn-light border w-100 py-1 fw-bold" onclick="addNum('7')">7</button></div>
      <div class="col-3"><button class="btn btn-light border w-100 py-1 fw-bold" onclick="addNum('8')">8</button></div>
      <div class="col-3"><button class="btn btn-light border w-100 py-1 fw-bold" onclick="addNum('9')">9</button></div>
      <div class="col-3"><button class="btn btn-success w-100 py-1" onclick="setOp('/')">÷</button></div>

      <div class="col-3"><button class="btn btn-light border w-100 py-1 fw-bold" onclick="addNum('4')">4</button></div>
      <div class="col-3"><button class="btn btn-light border w-100 py-1 fw-bold" onclick="addNum('5')">5</button></div>
      <div class="col-3"><button class="btn btn-light border w-100 py-1 fw-bold" onclick="addNum('6')">6</button></div>
      <div class="col-3"><button class="btn btn-success w-100 py-1" onclick="setOp('*')">×</button></div>

      <div class="col-3"><button class="btn btn-light border w-100 py-1 fw-bold" onclick="addNum('1')">1</button></div>
      <div class="col-3"><button class="btn btn-light border w-100 py-1 fw-bold" onclick="addNum('2')">2</button></div>
      <div class="col-3"><button class="btn btn-light border w-100 py-1 fw-bold" onclick="addNum('3')">3</button></div>
      <div class="col-3"><button class="btn btn-success w-100 py-1" onclick="setOp('-')">−</button></div>

      <div class="col-3"><button class="btn btn-danger w-100 py-1" onclick="clearCalc()">C</button></div>
      <div class="col-3"><button class="btn btn-light border w-100 py-1 fw-bold" onclick="addNum('0')">0</button></div>
      <div class="col-3"><button class="btn btn-light border w-100 py-1 fw-bold" onclick="addDecimal()">.</button></div>
      <div class="col-3"><button class="btn btn-success w-100 py-1" onclick="setOp('+')">+</button></div>
      <div class="row g-1">
        <div class="col-12 mt-2">
          <button class="btn btn-primary w-100 fw-bold" onclick="calcular()">
            TOTAL <small>(Enter)</small>
          </button>
        </div>

        <div class="col-8">
          <button class="btn btn-success w-100 fw-bold btn-sm" onclick="pegarResultado()">
            <i class="fas fa-sign-in-alt"></i> PEGAR (P)
          </button>
        </div>
        <div class="col-4">
          <button class="btn btn-outline-success w-100 btn-sm" onclick="copiarResultado(event)" title="Copiar Total">
            <i class="fas fa-paste"></i>
          </button>
        </div>

        <div class="col-4">
          <button class="btn btn-outline-secondary w-100 btn-sm" onclick="backspace()" title="Borrar último">
            <i class="fas fa-backspace"></i>
          </button>
        </div>
        <div class="col-4">
          <button class="btn btn-outline-secondary w-100 btn-sm" onclick="copiarCinta()" title="Copiar Registro">
            <i class="fas fa-copy"></i>
          </button>
        </div>
        <div class="col-4">
          <button class="btn btn-outline-danger w-100 btn-sm" onclick="clearCalc()" title="Limpiar Todo">
            <i class="fas fa-trash-alt"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="toast-container position-fixed bottom-0 start-0 p-3" style="z-index: 10000;">
  <div id="toastAtajo" class="toast align-items-center text-white bg-dark border-0" role="alert" aria-live="assertive"
    aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body" id="toastMensaje">
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"
        aria-label="Close"></button>
    </div>
  </div>
</div>
<script src="/static/js/calculadora.js"></script>
{{>'partials/footer'}}
