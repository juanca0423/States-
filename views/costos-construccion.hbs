{{> 'partials/header'}}
{{> 'partials/nav'}}
<h1>{{Title}}</h1>

<div class="container d-flex align-items-center justify-content-center" style="min-height: 80vh;">
  <div class="text-center p-5 shadow-sm rounded-4 border border-dashed" style="background-color: #f8f9fa;">
    <div class="mb-4">
      <i class="fas fa-drafting-pencil fa-4x text-muted opacity-25"></i>
      <i class="fas fa-calculator fa-3x text-success ms-n3 position-absolute mt-3 animate-bounce"></i>
    </div>

    <h2 class="fw-bold text-dark">Área de Costos en Proceso de Auditoría</h2>
    <p class="text-muted mx-auto" style="max-width: 500px;">
      Estamos configurando los módulos de <strong>Materia Prima, Mano de Obra y Gastos Indirectos</strong> para que
      cumplan con los estándares de la nomenclatura industrial.
    </p>

    <div class="progress mb-4" style="height: 10px; border-radius: 20px;">
      <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" role="progressbar"
        style="width: 65%;"></div>
    </div>

    <div class="d-flex justify-content-center gap-3">
      <span class="badge bg-light text-dark border p-2">Asignación de CIF: OK</span>
      <span class="badge bg-light text-dark border p-2">Kardex PEPS: Pendiente</span>
    </div>

    <a href="/" class="btn btn-outline-success mt-4">
      <i class="fas fa-arrow-left me-2"></i> Regresar al Panel Principal
    </a>
  </div>
</div>

<style>
  .animate-bounce {
    animation: bounce 2s infinite;
  }

  @keyframes bounce {

    0%,
    20%,
    50%,
    80%,
    100% {
      transform: translateY(0);
    }

    40% {
      transform: translateY(-10px);
    }
  }
</style>
{{>'partials/footer'}}
