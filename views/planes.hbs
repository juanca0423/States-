{{#if Error}}
<div class="alert alert-danger d-flex align-items-center mb-4" role="alert"
  style="background-color: #fdf2f2; border-left: 5px solid #d32f2f; color: #7f1d1d;">
  <i class="fas {{Icono}} me-3" style="font-size: 1.5rem;"></i>
  <div>
    <strong>Atención:</strong> {{Error}}
    <br>
    <small>Si el problema persiste, contacte a su banco o use el chat de consultoría.</small>
  </div>
</div>
{{/if}}

<input type="text" name="nombre_tarjeta" value="{{Datos.Nombre}}" class="form-control...">

