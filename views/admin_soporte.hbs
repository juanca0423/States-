{{> 'partials/header' }}
{{> 'partials/nav' }}

<div class="container mt-5">
  <h2 class="text-primary mb-4"><i class="fas fa-tools"></i> Bandeja de Consultas Técnicas</h2>

  {{#each Consultas}}
  <div class="card mb-4 shadow-sm border-0">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
      <span>
        <strong>Usuario:</strong> {{this.User.Nombre}} {{this.User.Apellido}}
        <small class="text-muted">({{this.User.Email}})</small>
      </span>
      <span class="badge {{#if (eq this.Estado 'Resuelto')}}bg-success{{else}}bg-warning text-dark{{/if}}">
        {{this.Estado}}
      </span>
    </div>
    <div class="card-body">
      <p class="mb-2"><strong>Duda del Auditor:</strong></p>
      <div class="p-3 bg-white border rounded mb-3 text-secondary">
        {{this.Consulta}}
      </div>

      {{#if this.Respuesta}}
      <div class="p-3 bg-success-subtle rounded border border-success-subtle">
        <p class="mb-1 text-success"><strong>Tu Respuesta:</strong></p>
        <p class="mb-0">{{this.Respuesta}}</p>
      </div>
      {{else}}
      <form action="/api/admin/soporte/responder/{{this.ID}}" method="POST">
        <div class="mb-3">
          <textarea name="respuesta" class="form-control" rows="3"
            placeholder="Escriba la respuesta técnica aquí..."></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Enviar Respuesta</button>
      </form>
      {{/if}}
    </div>
    <div class="card-footer text-muted small">
      Recibido: {{this.CreatedAt}}
    </div>
  </div>
  {{else}}
  <div class="alert alert-info">No hay consultas registradas en el sistema.</div>
  {{/each}}
</div>

{{> 'partials/footer' }}
