{{> "partials/header" }} {{> "partials/nav"}}

<div class="row justify-content-center mt-5">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h2 class="card-title text-center mb-4">Recuperar Contraseña</h2>

        {{#if Error}}
        <div class="alert alert-danger" role="alert">{{Error}}</div>
        {{/if}} {{#if Success}}
        <div class="alert alert-success" role="alert">{{Success}}</div>
        {{/if}}

        <form method="POST" action="/forgot-password">
          <div class="mb-3">
            <label for="email" class="form-label">Correo Electrónico</label>
            <input type="email" class="form-control" id="email" name="email" placeholder="tu@correo.com" required />
          </div>
          <div class="d-grid">
            <button type="submit" class="btn btn-primary">Enviar Enlace de Recuperación</button>
          </div>
        </form>

        <div class="text-center mt-3">
          <a href="/loguin">Volver al inicio de sesión</a>
        </div>
      </div>
    </div>
  </div>
</div>

{{> "partials/footer"}}
